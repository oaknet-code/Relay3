# ============================================
# RELAY BACKEND - ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git - it contains secrets!

# ============================================
# SERVER CONFIGURATION
# ============================================

# Port the server listens on
# Local development: 5000
# Hostinger: Must be 8080 (or whatever Hostinger assigns)
PORT=8080

# Node environment
# development = local testing with verbose logging
# production = deployed app with minimal logging
NODE_ENV=production

# ============================================
# DATABASE CONFIGURATION
# ============================================

# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
#
# For MongoDB Atlas (Cloud):
#   1. Go to https://cloud.mongodb.com
#   2. Create a cluster
#   3. Create a database user (not your account)
#   4. Get connection string from "Connect" → "Connect your application"
#   5. Replace <username>, <password>, and <database> in the string
#
# Example: mongodb+srv://relay_admin:MyPassword123@cluster0.mongodb.net/relay?retryWrites=true&w=majority
#
# For Local MongoDB:
#   mongodb://localhost:27017/relay
#
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/relay?retryWrites=true&w=majority

# ============================================
# SECURITY CONFIGURATION
# ============================================

# JWT Secret - Used to sign authentication tokens
# MUST BE:
#   - At least 32 characters long
#   - Random and unguessable
#   - Kept secret (never in git or exposed)
#
# Generate a secure secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# The server will refuse to start if this is missing or too short!
JWT_SECRET=your_random_secret_here_minimum_32_characters_generated_with_crypto

# ============================================
# CORS & FRONTEND CONFIGURATION
# ============================================

# Frontend URL - The domain where your frontend is hosted
# This is CRITICAL for CORS to work correctly
# Must match your frontend's exact URL (protocol + domain)
#
# Local development: http://localhost:3000 or http://localhost:5173
# Production: https://your-frontend-domain.com (NO trailing slash)
#
# Examples:
#   - https://yourdomain.com (correct)
#   - https://yourdomain.com/ (WRONG - extra slash)
#   - https://www.yourdomain.com (WRONG - different subdomain)
#   - http://yourdomain.com (WRONG - missing https)
#
# The backend will only accept requests from this origin.
# If your frontend shows CORS errors, check this value!
FRONTEND_URL=https://your-frontend-domain.com

# ============================================
# OPTIONAL: EMAIL CONFIGURATION
# ============================================

# If your app sends emails (e.g., password reset, notifications)
# Uncomment and configure these:

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# ============================================
# OPTIONAL: FILE UPLOAD CONFIGURATION
# ============================================

# Maximum file upload size (e.g., "10mb", "100mb")
# MAX_FILE_SIZE=10mb

# ============================================
# OPTIONAL: RATE LIMITING CONFIGURATION
# ============================================

# Requests per window for general API endpoints
# API_RATE_LIMIT_REQUESTS=100
# API_RATE_LIMIT_WINDOW_MS=15000

# Requests per window for login endpoint (tighter limit for security)
# LOGIN_RATE_LIMIT_REQUESTS=5
# LOGIN_RATE_LIMIT_WINDOW_MS=15000

# ============================================
# NOTES FOR HOSTINGER DEPLOYMENT
# ============================================

# 1. DO NOT commit this file to git (it's in .gitignore)
# 2. Copy values to Hostinger's environment variable settings
#    - Dashboard → Websites → Node.js → Environment Variables
# 3. For Hostinger MongoDB Atlas:
#    - Go to MongoDB Atlas → Network Access
#    - Add 0.0.0.0/0 to allow Hostinger's servers
# 4. Never share JWT_SECRET or MONGO_URI with anyone
# 5. Use strong, unique values in production
# 6. Test locally first before deploying to Hostinger

# ============================================
# TROUBLESHOOTING
# ============================================

# If server won't start:
# - Check that JWT_SECRET is at least 32 characters
# - Check that MONGO_URI is valid and properly formatted
# - Check that PORT is available (not in use)

# If CORS errors occur:
# - Verify FRONTEND_URL matches your frontend's domain exactly
# - No trailing slashes
# - Must include protocol (http:// or https://)

# If database connection fails:
# - Verify MONGO_URI is correct
# - Check MongoDB Atlas IP whitelist (allow 0.0.0.0/0)
# - Verify database user credentials
# - Check that database name exists in MongoDB
