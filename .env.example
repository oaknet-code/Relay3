# Backend Server Configuration
PORT=8080

# MongoDB Connection String
# For local development: mongodb://localhost:27017/relay
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/relay?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://relay_admin:password@cluster0.mongodb.net/relay?retryWrites=true&w=majority

# JWT Secret - MUST be a long, random, unguessable string (32+ chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=44c0804bc015563df5ad7f6d3f73f8146df2b9b4618e6be5d68d7c5c014c63a26834fb117c301ba4c89d0b263d809822

# Frontend URL - Must match your actual frontend origin exactly (protocol + host + port)
# For local development: http://localhost:3000 or http://localhost:5173
# For production: https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# Node Environment
NODE_ENV=production
